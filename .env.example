BACKEND_BASE_URL=http://94.184.32.84:8090
APP_ORIGIN=http://127.0.0.1:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Single Node process, persistent private directory. See docs/deployment.md.
SESSION_DIRECTORY=.makan-sessions
COOKIE_SECURE=false
# Exact platform owner role keys from the backend catalog. Empty = login disabled.
# School roles and generic platform administrators must not be added here.
PLATFORM_OWNER_ROLE_KEYS=[]
# Optional local-only negative login testing while the real owner key is unknown.
# Does not admit any principal without the configured owner role and permissions.
ALLOW_UNCONFIGURED_OWNER_OTP_TESTING=false
# JSON: exact METHOD + OpenAPI template -> exact backend permission, verified by backend team.
# Explicit overrides for the controller policies shipped in contracts/platform-permissions.json.
# An empty object retains documented defaults; an empty value disables that operation.
PERMISSION_BINDINGS={}
# Exact backend ProblemDetails.code values; leave empty until verified.
